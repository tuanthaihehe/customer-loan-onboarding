// Customer Loan Onboarding - ERD
// Updated from database/migrations through V26.
// Focus: tables, columns, and relationships. Index definitions are intentionally omitted.

Table customer {
  id uuid [pk]
  customer_code varchar(50) [not null, unique]
  full_name varchar(255) [not null]
  phone_number varchar(20) [unique]
  identity_number varchar(20) [unique]
  date_of_birth date
  status varchar(30) [not null, default: 'ACTIVE', note: 'ACTIVE, INACTIVE, BLACKLIST, LEAD']
  gender varchar(20) [note: 'MALE, FEMALE']
  email varchar(255) [unique]
  marital_status varchar(30) [note: 'SINGLE, MARRIED']
  permanent_address text
}

Table loan_application_state {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(100) [not null]
  description text
  is_initial boolean [not null, default: false]
  is_terminal boolean [not null, default: false]
  sort_order int [not null]
}

Table loan_application_state_transition {
  id uuid [pk]
  from_state_id uuid [not null]
  to_state_id uuid [not null]
  action_code varchar(50) [not null]
  action_name varchar(100) [not null]
  description text
}

Table loan_application {
  id uuid [pk]
  loan_application_code varchar(50) [not null, unique]
  customer_id uuid [not null]
  current_state_id uuid [not null]
  requested_amount numeric(18,2)
  loan_term_months int [note: 'Allowed terms: 3, 6, 9, 12, 18, 24']
  branch text
  asset_id uuid
  loan_purpose_id uuid
  loan_term_id uuid
  occupation_id uuid
  disbursement_bank_id uuid
  disbursement_account_number varchar(50)
  disbursement_account_name varchar(255)
  current_address text
  workplace_name varchar(255)
  workplace_address text
  monthly_income_amount numeric(18,2)
  loan_product_id uuid
  income_source_id uuid
}

Table loan_application_state_history {
  id uuid [pk]
  loan_application_id uuid [not null]
  from_state_id uuid
  to_state_id uuid [not null]
  action_code varchar(50) [not null]
  changed_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  changed_by varchar(100)
  note text
}

Table loan_application_step {
  code varchar(50) [pk]
  name varchar(255) [not null]
  step_order int [not null, unique]
  description text
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table loan_application_draft {
  id uuid [pk]
  draft_code varchar(50) [not null, unique]
  customer_id uuid [not null]
  current_step_code varchar(50) [not null]
  status varchar(30) [not null, default: 'DRAFT', note: 'DRAFT, COMPLETED, CONVERTED, CANCELLED, EXPIRED']
  converted_loan_application_id uuid
  expired_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table loan_application_draft_step_data {
  id uuid [pk]
  draft_id uuid [not null]
  step_code varchar(50) [not null]
  status varchar(30) [not null, default: 'NOT_STARTED', note: 'NOT_STARTED, IN_PROGRESS, COMPLETED']
  payload jsonb [not null, default: '{}']
  completed_at timestamp
  invalidated_at timestamp
  invalidated_reason text
  requires_review boolean [not null, default: false]
  invalidated_by_step_code varchar(50)
  reviewed_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table loan_application_draft_history {
  id uuid [pk]
  draft_id uuid [not null]
  step_code varchar(50)
  action varchar(50) [not null, note: 'CREATE_DRAFT, START_STEP, SAVE_STEP, COMPLETE_STEP, REOPEN_STEP, INVALIDATE_STEP, CANCEL_DRAFT, EXPIRE_DRAFT, COMPLETE_DRAFT, CONVERT_DRAFT']
  old_status varchar(30)
  new_status varchar(30)
  note text
  changed_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  metadata jsonb [not null, default: '{}']
}

Table loan_application_reference_person {
  id uuid [pk]
  loan_application_id uuid [not null]
  full_name varchar(255) [not null]
  phone_number varchar(20) [not null]
  address text
  relationship_type varchar(50) [not null, note: 'FATHER, MOTHER, SPOUSE, SIBLING, RELATIVE, FRIEND, COLLEAGUE, OTHER']
  note text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table document_type {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(255) [not null]
  description text
  is_required boolean [not null, default: false]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table loan_application_document {
  id uuid [pk]
  loan_application_id uuid [not null]
  document_type_id uuid [not null]
  file_url text [not null]
  file_name varchar(255)
  uploaded_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  uploaded_by varchar(100)
  note text
}

Table kyc_profile {
  id uuid [pk]
  customer_id uuid [not null]
  loan_application_id uuid [unique]
  face_match_score numeric(5,2)
  liveness_detection_score numeric(5,2)
  checked_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  note text
}

Table loan_purpose {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(100) [not null]
  description text
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table loan_term {
  id uuid [pk]
  code varchar(50) [not null, unique]
  term_months int [not null, unique]
  name varchar(100) [not null]
  description text
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table bank {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(255) [not null]
  short_name varchar(100)
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table occupation {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(255) [not null]
  description text
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table income_source {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(255) [not null]
  description text
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table score_grade {
  id uuid [pk]
  code varchar(10) [not null, unique]
  name varchar(100) [not null]
  description text
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table loan_product {
  id uuid [pk]
  product_code varchar(50) [not null, unique]
  product_name varchar(255) [not null]
  applies_to_all_loan_purposes boolean [not null, default: false]
  min_loan_amount numeric(18,2) [not null]
  max_loan_amount numeric(18,2) [not null]
  max_ltv_percent numeric(5,2) [not null]
  monthly_interest_rate_percent numeric(5,2) [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table loan_product_purpose {
  loan_product_id uuid [not null]
  loan_purpose_id uuid [not null]
}

Table loan_product_vehicle_type {
  loan_product_id uuid [not null]
  vehicle_type_id uuid [not null]
}

Table loan_product_term {
  loan_product_id uuid [not null]
  loan_term_id uuid [not null]
}

Table loan_product_score_grade {
  loan_product_id uuid [not null]
  score_grade_id uuid [not null]
}

Table vehicle_type {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(100) [not null]
  description text
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table vehicle_brand {
  id uuid [pk]
  vehicle_type_id uuid [not null]
  code varchar(50) [not null]
  name varchar(100) [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table vehicle_model {
  id uuid [pk]
  vehicle_brand_id uuid [not null]
  code varchar(50) [not null]
  name varchar(100) [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table vehicle_version {
  id uuid [pk]
  vehicle_model_id uuid [not null]
  code varchar(50) [not null]
  name varchar(100) [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table vehicle_year {
  id uuid [pk]
  vehicle_version_id uuid [not null]
  manufacture_year int [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table vehicle_color {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(100) [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table vehicle_variant {
  id uuid [pk]
  vehicle_year_id uuid [not null]
  vehicle_color_id uuid [not null]
  code varchar(100) [not null, unique]
  name varchar(255) [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table vehicle_market_price {
  id uuid [pk]
  vehicle_variant_id uuid [not null]
  price_amount numeric(18,2) [not null]
  currency_code varchar(3) [not null, default: 'VND']
  price_source varchar(100)
  effective_from date [not null]
  effective_to date
  note text
}

Table asset {
  id uuid [pk]
  asset_code varchar(50) [not null, unique]
  vehicle_variant_id uuid [not null]
  license_plate varchar(20) [not null, unique]
  status varchar(30) [not null, default: 'AVAILABLE', note: 'AVAILABLE, PLEDGED, RELEASED, SETTLED']
  frame_number varchar(100) [unique]
  engine_number varchar(100) [unique]
  registration_issue_date date
  registration_certificate_number varchar(100) [unique]
}

Table asset_deduction_type {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(100) [not null]
  description text
  deduction_amount numeric(18,2) [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table asset_valuation {
  id uuid [pk]
  asset_id uuid [not null]
  market_price_amount numeric(18,2) [not null]
  total_deduction_amount numeric(18,2) [not null, default: 0]
  final_value_amount numeric(18,2) [not null]
  currency_code varchar(3) [not null, default: 'VND']
  valuation_source varchar(100)
  valued_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  valued_by varchar(100)
  note text
}

Table asset_valuation_deduction {
  id uuid [pk]
  asset_valuation_id uuid [not null]
  deduction_type_id uuid [not null]
  deduction_amount_snapshot numeric(18,2) [not null]
  note text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table income_score_band {
  id uuid [pk]
  rule_set_code varchar(50) [not null, default: 'BASIC_SCORING_V1']
  min_income_amount numeric(18,2) [not null]
  max_income_amount numeric(18,2)
  score_value numeric(10,2) [not null]
  weight numeric(5,4) [not null, default: 0.3000]
  display_label varchar(255)
  priority int [not null, default: 0]
  is_active boolean [not null, default: true]
  effective_from date [not null, default: `CURRENT_DATE`]
  effective_to date
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table age_score_band {
  id uuid [pk]
  rule_set_code varchar(50) [not null, default: 'BASIC_SCORING_V1']
  min_age int [not null]
  max_age int
  score_value numeric(10,2) [not null]
  weight numeric(5,4) [not null, default: 0.4000]
  display_label varchar(255)
  priority int [not null, default: 0]
  is_active boolean [not null, default: true]
  effective_from date [not null, default: `CURRENT_DATE`]
  effective_to date
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table dependent_score_band {
  id uuid [pk]
  rule_set_code varchar(50) [not null, default: 'BASIC_SCORING_V1']
  min_dependent_count int [not null]
  max_dependent_count int
  score_value numeric(10,2) [not null]
  weight numeric(5,4) [not null, default: 0.3000]
  display_label varchar(255)
  priority int [not null, default: 0]
  is_active boolean [not null, default: true]
  effective_from date [not null, default: `CURRENT_DATE`]
  effective_to date
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table overall_score_grade_band {
  id uuid [pk]
  rule_set_code varchar(50) [not null, default: 'BASIC_SCORING_V1']
  grade_code varchar(10) [not null]
  min_score numeric(10,2) [not null]
  max_score numeric(10,2)
  display_label varchar(255)
  priority int [not null, default: 0]
  is_active boolean [not null, default: true]
  effective_from date [not null, default: `CURRENT_DATE`]
  effective_to date
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Ref: customer.id < loan_application.customer_id
Ref: loan_application_state.id < loan_application.current_state_id
Ref: asset.id < loan_application.asset_id
Ref: loan_purpose.id < loan_application.loan_purpose_id
Ref: loan_term.id < loan_application.loan_term_id
Ref: occupation.id < loan_application.occupation_id
Ref: bank.id < loan_application.disbursement_bank_id
Ref: loan_product.id < loan_application.loan_product_id
Ref: income_source.id < loan_application.income_source_id

Ref: loan_application_state.id < loan_application_state_transition.from_state_id
Ref: loan_application_state.id < loan_application_state_transition.to_state_id
Ref: loan_application.id < loan_application_state_history.loan_application_id
Ref: loan_application_state.id < loan_application_state_history.from_state_id
Ref: loan_application_state.id < loan_application_state_history.to_state_id

Ref: customer.id < loan_application_draft.customer_id
Ref: loan_application_step.code < loan_application_draft.current_step_code
Ref: loan_application.id < loan_application_draft.converted_loan_application_id
Ref: loan_application_draft.id < loan_application_draft_step_data.draft_id
Ref: loan_application_step.code < loan_application_draft_step_data.step_code
Ref: loan_application_step.code < loan_application_draft_step_data.invalidated_by_step_code
Ref: loan_application_draft.id < loan_application_draft_history.draft_id
Ref: loan_application_step.code < loan_application_draft_history.step_code

Ref: loan_application.id < loan_application_reference_person.loan_application_id
Ref: loan_application.id < loan_application_document.loan_application_id
Ref: document_type.id < loan_application_document.document_type_id
Ref: customer.id < kyc_profile.customer_id
Ref: loan_application.id < kyc_profile.loan_application_id

Ref: vehicle_type.id < vehicle_brand.vehicle_type_id
Ref: vehicle_brand.id < vehicle_model.vehicle_brand_id
Ref: vehicle_model.id < vehicle_version.vehicle_model_id
Ref: vehicle_version.id < vehicle_year.vehicle_version_id
Ref: vehicle_year.id < vehicle_variant.vehicle_year_id
Ref: vehicle_color.id < vehicle_variant.vehicle_color_id
Ref: vehicle_variant.id < vehicle_market_price.vehicle_variant_id
Ref: vehicle_variant.id < asset.vehicle_variant_id

Ref: asset.id < asset_valuation.asset_id
Ref: asset_valuation.id < asset_valuation_deduction.asset_valuation_id
Ref: asset_deduction_type.id < asset_valuation_deduction.deduction_type_id

Ref: loan_product.id < loan_product_purpose.loan_product_id
Ref: loan_purpose.id < loan_product_purpose.loan_purpose_id
Ref: loan_product.id < loan_product_vehicle_type.loan_product_id
Ref: vehicle_type.id < loan_product_vehicle_type.vehicle_type_id
Ref: loan_product.id < loan_product_term.loan_product_id
Ref: loan_term.id < loan_product_term.loan_term_id
Ref: loan_product.id < loan_product_score_grade.loan_product_id
Ref: score_grade.id < loan_product_score_grade.score_grade_id
