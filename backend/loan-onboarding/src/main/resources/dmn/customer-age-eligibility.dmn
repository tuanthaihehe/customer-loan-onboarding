<?xml version="1.0" encoding="UTF-8"?>
<definitions
        xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_CustomerAgeEligibility"
        name="Customer Age Eligibility"
        namespace="https://f88.com.vn/loan-onboarding/dmn/customer">
    <decision id="customerAgeEligibility" name="Customer Age Eligibility">
        <decisionTable id="DecisionTable_CustomerAgeEligibility" hitPolicy="FIRST">
            <input id="Input_Age" label="Customer age">
                <inputExpression id="InputExpression_Age" typeRef="integer">
                    <text>age</text>
                </inputExpression>
            </input>
            <output id="Output_Eligible" label="Eligible" name="eligible" typeRef="boolean"/>
            <output id="Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="Rule_Under18">
                <inputEntry id="InputEntry_Under18">
                    <text>&lt; 18</text>
                </inputEntry>
                <outputEntry id="OutputEntry_Under18Eligible">
                    <text>false</text>
                </outputEntry>
                <outputEntry id="OutputEntry_Under18ReasonCode">
                    <text>"CUSTOMER_UNDER_AGE"</text>
                </outputEntry>
                <outputEntry id="OutputEntry_Under18ReasonMessage">
                    <text>"Khach hang chua du 18 tuoi, khong du dieu kien tao ho so vay."</text>
                </outputEntry>
            </rule>
            <rule id="Rule_Adult">
                <inputEntry id="InputEntry_Adult">
                    <text>&gt;= 18</text>
                </inputEntry>
                <outputEntry id="OutputEntry_AdultEligible">
                    <text>true</text>
                </outputEntry>
                <outputEntry id="OutputEntry_AdultReasonCode">
                    <text>null</text>
                </outputEntry>
                <outputEntry id="OutputEntry_AdultReasonMessage">
                    <text>null</text>
                </outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
