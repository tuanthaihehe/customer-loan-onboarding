<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_LoanProductScoreEligibility"
        name="Loan Product Score Eligibility"
        namespace="https://f88.com.vn/loan-onboarding/dmn/loan-product">
    <decision id="loanProductScoreEligibility" name="Loan Product Score Eligibility">
        <decisionTable id="DecisionTable_LoanProductScoreEligibility" hitPolicy="FIRST">
            <input id="Input_ScoreGrade" label="Score grade">
                <inputExpression id="InputExpression_ScoreGrade" typeRef="string">
                    <text>scoreGrade</text>
                </inputExpression>
            </input>
            <input id="Input_ScoreAllowedByProduct" label="Score allowed by product">
                <inputExpression id="InputExpression_ScoreAllowedByProduct" typeRef="boolean">
                    <text>list contains(allowedScoreGrades, scoreGrade)</text>
                </inputExpression>
            </input>
            <output id="Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="Rule_ProductScoreNull">
                <inputEntry id="InputEntry_ProductScoreNull"><text>null</text></inputEntry>
                <inputEntry id="InputEntry_ProductScoreNullAllowed"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_ProductScoreNullPassed"><text>true</text></outputEntry>
                <outputEntry id="OutputEntry_ProductScoreNullReasonCode"><text>null</text></outputEntry>
                <outputEntry id="OutputEntry_ProductScoreNullReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="Rule_ProductScoreBlank">
                <inputEntry id="InputEntry_ProductScoreBlank"><text>""</text></inputEntry>
                <inputEntry id="InputEntry_ProductScoreBlankAllowed"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_ProductScoreBlankPassed"><text>true</text></outputEntry>
                <outputEntry id="OutputEntry_ProductScoreBlankReasonCode"><text>null</text></outputEntry>
                <outputEntry id="OutputEntry_ProductScoreBlankReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="Rule_ProductScoreAllowed">
                <inputEntry id="InputEntry_ProductScoreAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_ProductScoreAllowed"><text>true</text></inputEntry>
                <outputEntry id="OutputEntry_ProductScoreAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="OutputEntry_ProductScoreAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="OutputEntry_ProductScoreAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="Rule_ProductScoreNotAllowed">
                <inputEntry id="InputEntry_ProductScoreNotAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_ProductScoreNotAllowed"><text>false</text></inputEntry>
                <outputEntry id="OutputEntry_ProductScoreNotAllowedPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_ProductScoreNotAllowedReasonCode"><text>"LOAN_PRODUCT_SCORE_ALLOWED"</text></outputEntry>
                <outputEntry id="OutputEntry_ProductScoreNotAllowedReasonMessage"><text>"San pham khong ap dung cho hang diem da chon."</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
