<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_AssetRules"
        name="Asset Rules"
        namespace="https://f88.com.vn/loan-onboarding/dmn/asset-rules">
<decision id="assetRequiredCheck" name="Asset Required Check">
        <decisionTable id="AssetRequired_DecisionTable_AssetRequiredCheck" hitPolicy="FIRST">
            <input id="AssetRequired_Input_AssetType" label="Asset type">
                <inputExpression id="AssetRequired_InputExpression_AssetType" typeRef="string">
                    <text>assetType</text>
                </inputExpression>
            </input>
            <input id="AssetRequired_Input_LicensePlate" label="License plate">
                <inputExpression id="AssetRequired_InputExpression_LicensePlate" typeRef="string">
                    <text>licensePlate</text>
                </inputExpression>
            </input>
            <output id="AssetRequired_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="AssetRequired_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="AssetRequired_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="AssetRequired_Rule_MissingAssetType">
                <inputEntry id="AssetRequired_InputEntry_MissingAssetType"><text>null</text></inputEntry>
                <inputEntry id="AssetRequired_InputEntry_MissingAssetTypePlate"><text>-</text></inputEntry>
                <outputEntry id="AssetRequired_OutputEntry_MissingAssetTypePassed"><text>false</text></outputEntry>
                <outputEntry id="AssetRequired_OutputEntry_MissingAssetTypeReasonCode"><text>"ASSET_REQUIRED"</text></outputEntry>
                <outputEntry id="AssetRequired_OutputEntry_MissingAssetTypeReasonMessage"><text>"Asset type and license plate are required before linking asset to loan application"</text></outputEntry>
            </rule>
            <rule id="AssetRequired_Rule_MissingLicensePlateNull">
                <inputEntry id="AssetRequired_InputEntry_MissingLicensePlateNullAssetType"><text>-</text></inputEntry>
                <inputEntry id="AssetRequired_InputEntry_MissingLicensePlateNull"><text>null</text></inputEntry>
                <outputEntry id="AssetRequired_OutputEntry_MissingLicensePlateNullPassed"><text>false</text></outputEntry>
                <outputEntry id="AssetRequired_OutputEntry_MissingLicensePlateNullReasonCode"><text>"ASSET_REQUIRED"</text></outputEntry>
                <outputEntry id="AssetRequired_OutputEntry_MissingLicensePlateNullReasonMessage"><text>"Asset type and license plate are required before linking asset to loan application"</text></outputEntry>
            </rule>
            <rule id="AssetRequired_Rule_MissingLicensePlateBlank">
                <inputEntry id="AssetRequired_InputEntry_MissingLicensePlateBlankAssetType"><text>-</text></inputEntry>
                <inputEntry id="AssetRequired_InputEntry_MissingLicensePlateBlank"><text>""</text></inputEntry>
                <outputEntry id="AssetRequired_OutputEntry_MissingLicensePlateBlankPassed"><text>false</text></outputEntry>
                <outputEntry id="AssetRequired_OutputEntry_MissingLicensePlateBlankReasonCode"><text>"ASSET_REQUIRED"</text></outputEntry>
                <outputEntry id="AssetRequired_OutputEntry_MissingLicensePlateBlankReasonMessage"><text>"Asset type and license plate are required before linking asset to loan application"</text></outputEntry>
            </rule>
            <rule id="AssetRequired_Rule_AssetRequiredPassed">
                <inputEntry id="AssetRequired_InputEntry_AssetRequiredPassedAssetType"><text>-</text></inputEntry>
                <inputEntry id="AssetRequired_InputEntry_AssetRequiredPassedLicensePlate"><text>-</text></inputEntry>
                <outputEntry id="AssetRequired_OutputEntry_AssetRequiredPassed"><text>true</text></outputEntry>
                <outputEntry id="AssetRequired_OutputEntry_AssetRequiredReasonCode"><text>null</text></outputEntry>
                <outputEntry id="AssetRequired_OutputEntry_AssetRequiredReasonMessage"><text>null</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
<decision id="assetDuplicateCheck" name="Asset Duplicate Check">
        <decisionTable id="AssetDuplicate_DecisionTable_AssetDuplicateCheck" hitPolicy="FIRST">
            <input id="AssetDuplicate_Input_DuplicatedAsset" label="Duplicated asset">
                <inputExpression id="AssetDuplicate_InputExpression_DuplicatedAsset" typeRef="boolean">
                    <text>duplicatedAsset</text>
                </inputExpression>
            </input>
            <output id="AssetDuplicate_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="AssetDuplicate_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="AssetDuplicate_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="AssetDuplicate_Rule_DuplicatedAsset">
                <inputEntry id="AssetDuplicate_InputEntry_DuplicatedAsset"><text>true</text></inputEntry>
                <outputEntry id="AssetDuplicate_OutputEntry_DuplicatedAssetPassed"><text>false</text></outputEntry>
                <outputEntry id="AssetDuplicate_OutputEntry_DuplicatedAssetReasonCode"><text>"ASSET_DUPLICATE_CHECK"</text></outputEntry>
                <outputEntry id="AssetDuplicate_OutputEntry_DuplicatedAssetReasonMessage"><text>"Asset already exists or is already linked to another active loan application"</text></outputEntry>
            </rule>
            <rule id="AssetDuplicate_Rule_NotDuplicatedAsset">
                <inputEntry id="AssetDuplicate_InputEntry_NotDuplicatedAsset"><text>false</text></inputEntry>
                <outputEntry id="AssetDuplicate_OutputEntry_NotDuplicatedAssetPassed"><text>true</text></outputEntry>
                <outputEntry id="AssetDuplicate_OutputEntry_NotDuplicatedAssetReasonCode"><text>null</text></outputEntry>
                <outputEntry id="AssetDuplicate_OutputEntry_NotDuplicatedAssetReasonMessage"><text>null</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
