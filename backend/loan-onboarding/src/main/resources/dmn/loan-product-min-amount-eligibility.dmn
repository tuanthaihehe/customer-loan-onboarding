<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_LoanProductMinAmountEligibility"
        name="Loan Product Min Amount Eligibility"
        namespace="https://f88.com.vn/loan-onboarding/dmn/loan-product">
    <decision id="loanProductMinAmountEligibility" name="Loan Product Min Amount Eligibility">
        <decisionTable id="DecisionTable_LoanProductMinAmountEligibility" hitPolicy="FIRST">
            <input id="Input_MinLoanAmount" label="Product min loan amount">
                <inputExpression id="InputExpression_MinLoanAmount" typeRef="number">
                    <text>minLoanAmount</text>
                </inputExpression>
            </input>
            <input id="Input_EffectiveMaxLoanAmount" label="Effective max loan amount">
                <inputExpression id="InputExpression_EffectiveMaxLoanAmount" typeRef="number">
                    <text>effectiveMaxLoanAmount</text>
                </inputExpression>
            </input>
            <output id="Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="Rule_MinLoanAmountNull">
                <inputEntry id="InputEntry_MinLoanAmountNull"><text>null</text></inputEntry>
                <inputEntry id="InputEntry_MinLoanAmountNullEffective"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_MinLoanAmountNullPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_MinLoanAmountNullReasonCode"><text>"LOAN_PRODUCT_MIN_AMOUNT_ALLOWED"</text></outputEntry>
                <outputEntry id="OutputEntry_MinLoanAmountNullReasonMessage"><text>"Product min amount and effective max loan amount are required"</text></outputEntry>
            </rule>
            <rule id="Rule_EffectiveMaxLoanAmountNull">
                <inputEntry id="InputEntry_EffectiveMaxLoanAmountNullMin"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_EffectiveMaxLoanAmountNull"><text>null</text></inputEntry>
                <outputEntry id="OutputEntry_EffectiveMaxLoanAmountNullPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_EffectiveMaxLoanAmountNullReasonCode"><text>"LOAN_PRODUCT_MIN_AMOUNT_ALLOWED"</text></outputEntry>
                <outputEntry id="OutputEntry_EffectiveMaxLoanAmountNullReasonMessage"><text>"Product min amount and effective max loan amount are required"</text></outputEntry>
            </rule>
            <rule id="Rule_EffectiveMaxMeetsMin">
                <inputEntry id="InputEntry_EffectiveMaxMeetsMinMin"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_EffectiveMaxMeetsMin"><text>&gt;= minLoanAmount</text></inputEntry>
                <outputEntry id="OutputEntry_EffectiveMaxMeetsMinPassed"><text>true</text></outputEntry>
                <outputEntry id="OutputEntry_EffectiveMaxMeetsMinReasonCode"><text>null</text></outputEntry>
                <outputEntry id="OutputEntry_EffectiveMaxMeetsMinReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="Rule_EffectiveMaxBelowMin">
                <inputEntry id="InputEntry_EffectiveMaxBelowMinMin"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_EffectiveMaxBelowMin"><text>&lt; minLoanAmount</text></inputEntry>
                <outputEntry id="OutputEntry_EffectiveMaxBelowMinPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_EffectiveMaxBelowMinReasonCode"><text>"LOAN_PRODUCT_MIN_AMOUNT_ALLOWED"</text></outputEntry>
                <outputEntry id="OutputEntry_EffectiveMaxBelowMinReasonMessage"><text>"San pham khong dat so tien vay toi thieu voi gia tri tai san hien tai."</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
