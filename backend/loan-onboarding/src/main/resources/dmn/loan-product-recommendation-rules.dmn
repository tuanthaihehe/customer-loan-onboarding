<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_LoanProductRecommendationRules"
        name="Loan Product Recommendation Rules"
        namespace="https://f88.com.vn/loan-onboarding/dmn/loan-product-recommendation-rules">
<decision id="loanProductPurposeEligibility" name="Loan Product Purpose Eligibility">
        <decisionTable id="ProductPurpose_DecisionTable_LoanProductPurposeEligibility" hitPolicy="FIRST">
            <input id="ProductPurpose_Input_LoanPurpose" label="Selected loan purpose">
                <inputExpression id="ProductPurpose_InputExpression_LoanPurpose" typeRef="string">
                    <text>loanPurpose</text>
                </inputExpression>
            </input>
            <input id="ProductPurpose_Input_AppliesToAllLoanPurposes" label="Applies to all loan purposes">
                <inputExpression id="ProductPurpose_InputExpression_AppliesToAllLoanPurposes" typeRef="boolean">
                    <text>appliesToAllLoanPurposes</text>
                </inputExpression>
            </input>
            <input id="ProductPurpose_Input_PurposeAllowedByProduct" label="Purpose allowed by product">
                <inputExpression id="ProductPurpose_InputExpression_PurposeAllowedByProduct" typeRef="boolean">
                    <text>list contains(allowedLoanPurposes, loanPurpose)</text>
                </inputExpression>
            </input>
            <output id="ProductPurpose_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="ProductPurpose_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="ProductPurpose_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="ProductPurpose_Rule_ProductPurposeNull">
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeNull"><text>null</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeNullAll"><text>-</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeNullAllowed"><text>-</text></inputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeNullPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeNullReasonCode"><text>"LOAN_PRODUCT_PURPOSE_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeNullReasonMessage"><text>"Loan purpose is required"</text></outputEntry>
            </rule>
            <rule id="ProductPurpose_Rule_ProductPurposeBlank">
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeBlank"><text>""</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeBlankAll"><text>-</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeBlankAllowed"><text>-</text></inputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeBlankPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeBlankReasonCode"><text>"LOAN_PRODUCT_PURPOSE_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeBlankReasonMessage"><text>"Loan purpose is required"</text></outputEntry>
            </rule>
            <rule id="ProductPurpose_Rule_ProductPurposeAll">
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeAllValue"><text>-</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeAll"><text>true</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeAllAllowed"><text>-</text></inputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeAllPassed"><text>true</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeAllReasonCode"><text>null</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeAllReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="ProductPurpose_Rule_ProductPurposeAllowed">
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeAllowedAll"><text>false</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeAllowed"><text>true</text></inputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="ProductPurpose_Rule_ProductPurposeNotAllowed">
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeNotAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeNotAllowedAll"><text>false</text></inputEntry>
                <inputEntry id="ProductPurpose_InputEntry_ProductPurposeNotAllowed"><text>false</text></inputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeNotAllowedPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeNotAllowedReasonCode"><text>"LOAN_PRODUCT_PURPOSE_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductPurpose_OutputEntry_ProductPurposeNotAllowedReasonMessage"><text>"San pham khong ap dung cho muc dich vay da chon."</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
<decision id="loanProductAssetTypeEligibility" name="Loan Product Asset Type Eligibility">
        <decisionTable id="ProductAssetType_DecisionTable_LoanProductAssetTypeEligibility" hitPolicy="FIRST">
            <input id="ProductAssetType_Input_AssetType" label="Selected asset type">
                <inputExpression id="ProductAssetType_InputExpression_AssetType" typeRef="string">
                    <text>assetType</text>
                </inputExpression>
            </input>
            <input id="ProductAssetType_Input_AssetTypeAllowedByProduct" label="Asset type allowed by product">
                <inputExpression id="ProductAssetType_InputExpression_AssetTypeAllowedByProduct" typeRef="boolean">
                    <text>list contains(allowedAssetTypes, assetType)</text>
                </inputExpression>
            </input>
            <output id="ProductAssetType_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="ProductAssetType_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="ProductAssetType_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="ProductAssetType_Rule_ProductAssetTypeNull">
                <inputEntry id="ProductAssetType_InputEntry_ProductAssetTypeNull"><text>null</text></inputEntry>
                <inputEntry id="ProductAssetType_InputEntry_ProductAssetTypeNullAllowed"><text>-</text></inputEntry>
                <outputEntry id="ProductAssetType_OutputEntry_ProductAssetTypeNullPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductAssetType_OutputEntry_ProductAssetTypeNullReasonCode"><text>"LOAN_PRODUCT_ASSET_TYPE_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductAssetType_OutputEntry_ProductAssetTypeNullReasonMessage"><text>"Asset type is required"</text></outputEntry>
            </rule>
            <rule id="ProductAssetType_Rule_ProductAssetTypeAllowed">
                <inputEntry id="ProductAssetType_InputEntry_ProductAssetTypeAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="ProductAssetType_InputEntry_ProductAssetTypeAllowed"><text>true</text></inputEntry>
                <outputEntry id="ProductAssetType_OutputEntry_ProductAssetTypeAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="ProductAssetType_OutputEntry_ProductAssetTypeAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="ProductAssetType_OutputEntry_ProductAssetTypeAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="ProductAssetType_Rule_ProductAssetTypeNotAllowed">
                <inputEntry id="ProductAssetType_InputEntry_ProductAssetTypeNotAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="ProductAssetType_InputEntry_ProductAssetTypeNotAllowed"><text>false</text></inputEntry>
                <outputEntry id="ProductAssetType_OutputEntry_ProductAssetTypeNotAllowedPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductAssetType_OutputEntry_ProductAssetTypeNotAllowedReasonCode"><text>"LOAN_PRODUCT_ASSET_TYPE_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductAssetType_OutputEntry_ProductAssetTypeNotAllowedReasonMessage"><text>"San pham khong ap dung cho loai tai san da chon."</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
<decision id="loanProductTenorEligibility" name="Loan Product Tenor Eligibility">
        <decisionTable id="ProductTenor_DecisionTable_LoanProductTenorEligibility" hitPolicy="FIRST">
            <input id="ProductTenor_Input_RequestedTenure" label="Selected tenor">
                <inputExpression id="ProductTenor_InputExpression_RequestedTenure" typeRef="integer">
                    <text>requestedTenure</text>
                </inputExpression>
            </input>
            <input id="ProductTenor_Input_TenorAllowedByProduct" label="Tenor allowed by product">
                <inputExpression id="ProductTenor_InputExpression_TenorAllowedByProduct" typeRef="boolean">
                    <text>list contains(allowedTenors, requestedTenure)</text>
                </inputExpression>
            </input>
            <output id="ProductTenor_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="ProductTenor_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="ProductTenor_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="ProductTenor_Rule_ProductTenorNull">
                <inputEntry id="ProductTenor_InputEntry_ProductTenorNull"><text>null</text></inputEntry>
                <inputEntry id="ProductTenor_InputEntry_ProductTenorNullAllowed"><text>-</text></inputEntry>
                <outputEntry id="ProductTenor_OutputEntry_ProductTenorNullPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductTenor_OutputEntry_ProductTenorNullReasonCode"><text>"LOAN_PRODUCT_TENOR_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductTenor_OutputEntry_ProductTenorNullReasonMessage"><text>"Tenor is required"</text></outputEntry>
            </rule>
            <rule id="ProductTenor_Rule_ProductTenorAllowed">
                <inputEntry id="ProductTenor_InputEntry_ProductTenorAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="ProductTenor_InputEntry_ProductTenorAllowed"><text>true</text></inputEntry>
                <outputEntry id="ProductTenor_OutputEntry_ProductTenorAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="ProductTenor_OutputEntry_ProductTenorAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="ProductTenor_OutputEntry_ProductTenorAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="ProductTenor_Rule_ProductTenorNotAllowed">
                <inputEntry id="ProductTenor_InputEntry_ProductTenorNotAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="ProductTenor_InputEntry_ProductTenorNotAllowed"><text>false</text></inputEntry>
                <outputEntry id="ProductTenor_OutputEntry_ProductTenorNotAllowedPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductTenor_OutputEntry_ProductTenorNotAllowedReasonCode"><text>"LOAN_PRODUCT_TENOR_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductTenor_OutputEntry_ProductTenorNotAllowedReasonMessage"><text>"San pham khong ho tro ky han vay da chon."</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
<decision id="loanProductScoreEligibility" name="Loan Product Score Eligibility">
        <decisionTable id="ProductScore_DecisionTable_LoanProductScoreEligibility" hitPolicy="FIRST">
            <input id="ProductScore_Input_ScoreGrade" label="Score grade">
                <inputExpression id="ProductScore_InputExpression_ScoreGrade" typeRef="string">
                    <text>scoreGrade</text>
                </inputExpression>
            </input>
            <input id="ProductScore_Input_ScoreAllowedByProduct" label="Score allowed by product">
                <inputExpression id="ProductScore_InputExpression_ScoreAllowedByProduct" typeRef="boolean">
                    <text>list contains(allowedScoreGrades, scoreGrade)</text>
                </inputExpression>
            </input>
            <output id="ProductScore_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="ProductScore_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="ProductScore_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="ProductScore_Rule_ProductScoreNull">
                <inputEntry id="ProductScore_InputEntry_ProductScoreNull"><text>null</text></inputEntry>
                <inputEntry id="ProductScore_InputEntry_ProductScoreNullAllowed"><text>-</text></inputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreNullPassed"><text>true</text></outputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreNullReasonCode"><text>null</text></outputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreNullReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="ProductScore_Rule_ProductScoreBlank">
                <inputEntry id="ProductScore_InputEntry_ProductScoreBlank"><text>""</text></inputEntry>
                <inputEntry id="ProductScore_InputEntry_ProductScoreBlankAllowed"><text>-</text></inputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreBlankPassed"><text>true</text></outputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreBlankReasonCode"><text>null</text></outputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreBlankReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="ProductScore_Rule_ProductScoreAllowed">
                <inputEntry id="ProductScore_InputEntry_ProductScoreAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="ProductScore_InputEntry_ProductScoreAllowed"><text>true</text></inputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="ProductScore_Rule_ProductScoreNotAllowed">
                <inputEntry id="ProductScore_InputEntry_ProductScoreNotAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="ProductScore_InputEntry_ProductScoreNotAllowed"><text>false</text></inputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreNotAllowedPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreNotAllowedReasonCode"><text>"LOAN_PRODUCT_SCORE_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductScore_OutputEntry_ProductScoreNotAllowedReasonMessage"><text>"San pham khong ap dung cho hang diem da chon."</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
<decision id="loanProductMinAmountEligibility" name="Loan Product Min Amount Eligibility">
        <decisionTable id="ProductMinAmount_DecisionTable_LoanProductMinAmountEligibility" hitPolicy="FIRST">
            <input id="ProductMinAmount_Input_MinLoanAmount" label="Product min loan amount">
                <inputExpression id="ProductMinAmount_InputExpression_MinLoanAmount" typeRef="number">
                    <text>minLoanAmount</text>
                </inputExpression>
            </input>
            <input id="ProductMinAmount_Input_EffectiveMaxLoanAmount" label="Effective max loan amount">
                <inputExpression id="ProductMinAmount_InputExpression_EffectiveMaxLoanAmount" typeRef="number">
                    <text>effectiveMaxLoanAmount</text>
                </inputExpression>
            </input>
            <output id="ProductMinAmount_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="ProductMinAmount_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="ProductMinAmount_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="ProductMinAmount_Rule_MinLoanAmountNull">
                <inputEntry id="ProductMinAmount_InputEntry_MinLoanAmountNull"><text>null</text></inputEntry>
                <inputEntry id="ProductMinAmount_InputEntry_MinLoanAmountNullEffective"><text>-</text></inputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_MinLoanAmountNullPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_MinLoanAmountNullReasonCode"><text>"LOAN_PRODUCT_MIN_AMOUNT_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_MinLoanAmountNullReasonMessage"><text>"Product min amount and effective max loan amount are required"</text></outputEntry>
            </rule>
            <rule id="ProductMinAmount_Rule_EffectiveMaxLoanAmountNull">
                <inputEntry id="ProductMinAmount_InputEntry_EffectiveMaxLoanAmountNullMin"><text>-</text></inputEntry>
                <inputEntry id="ProductMinAmount_InputEntry_EffectiveMaxLoanAmountNull"><text>null</text></inputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_EffectiveMaxLoanAmountNullPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_EffectiveMaxLoanAmountNullReasonCode"><text>"LOAN_PRODUCT_MIN_AMOUNT_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_EffectiveMaxLoanAmountNullReasonMessage"><text>"Product min amount and effective max loan amount are required"</text></outputEntry>
            </rule>
            <rule id="ProductMinAmount_Rule_EffectiveMaxMeetsMin">
                <inputEntry id="ProductMinAmount_InputEntry_EffectiveMaxMeetsMinMin"><text>-</text></inputEntry>
                <inputEntry id="ProductMinAmount_InputEntry_EffectiveMaxMeetsMin"><text>&gt;= minLoanAmount</text></inputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_EffectiveMaxMeetsMinPassed"><text>true</text></outputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_EffectiveMaxMeetsMinReasonCode"><text>null</text></outputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_EffectiveMaxMeetsMinReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="ProductMinAmount_Rule_EffectiveMaxBelowMin">
                <inputEntry id="ProductMinAmount_InputEntry_EffectiveMaxBelowMinMin"><text>-</text></inputEntry>
                <inputEntry id="ProductMinAmount_InputEntry_EffectiveMaxBelowMin"><text>&lt; minLoanAmount</text></inputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_EffectiveMaxBelowMinPassed"><text>false</text></outputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_EffectiveMaxBelowMinReasonCode"><text>"LOAN_PRODUCT_MIN_AMOUNT_ALLOWED"</text></outputEntry>
                <outputEntry id="ProductMinAmount_OutputEntry_EffectiveMaxBelowMinReasonMessage"><text>"San pham khong dat so tien vay toi thieu voi gia tri tai san hien tai."</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
