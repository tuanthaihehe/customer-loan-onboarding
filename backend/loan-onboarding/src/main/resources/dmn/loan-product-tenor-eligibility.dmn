<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_LoanProductTenorEligibility"
        name="Loan Product Tenor Eligibility"
        namespace="https://f88.com.vn/loan-onboarding/dmn/loan-product">
    <decision id="loanProductTenorEligibility" name="Loan Product Tenor Eligibility">
        <decisionTable id="DecisionTable_LoanProductTenorEligibility" hitPolicy="FIRST">
            <input id="Input_RequestedTenure" label="Selected tenor">
                <inputExpression id="InputExpression_RequestedTenure" typeRef="integer">
                    <text>requestedTenure</text>
                </inputExpression>
            </input>
            <input id="Input_TenorAllowedByProduct" label="Tenor allowed by product">
                <inputExpression id="InputExpression_TenorAllowedByProduct" typeRef="boolean">
                    <text>list contains(allowedTenors, requestedTenure)</text>
                </inputExpression>
            </input>
            <output id="Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="Rule_ProductTenorNull">
                <inputEntry id="InputEntry_ProductTenorNull"><text>null</text></inputEntry>
                <inputEntry id="InputEntry_ProductTenorNullAllowed"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_ProductTenorNullPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_ProductTenorNullReasonCode"><text>"LOAN_PRODUCT_TENOR_ALLOWED"</text></outputEntry>
                <outputEntry id="OutputEntry_ProductTenorNullReasonMessage"><text>"Tenor is required"</text></outputEntry>
            </rule>
            <rule id="Rule_ProductTenorAllowed">
                <inputEntry id="InputEntry_ProductTenorAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_ProductTenorAllowed"><text>true</text></inputEntry>
                <outputEntry id="OutputEntry_ProductTenorAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="OutputEntry_ProductTenorAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="OutputEntry_ProductTenorAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="Rule_ProductTenorNotAllowed">
                <inputEntry id="InputEntry_ProductTenorNotAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_ProductTenorNotAllowed"><text>false</text></inputEntry>
                <outputEntry id="OutputEntry_ProductTenorNotAllowedPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_ProductTenorNotAllowedReasonCode"><text>"LOAN_PRODUCT_TENOR_ALLOWED"</text></outputEntry>
                <outputEntry id="OutputEntry_ProductTenorNotAllowedReasonMessage"><text>"San pham khong ho tro ky han vay da chon."</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
