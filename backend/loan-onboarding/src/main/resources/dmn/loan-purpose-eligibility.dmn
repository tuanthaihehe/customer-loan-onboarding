<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_LoanPurposeEligibility"
        name="Loan Purpose Eligibility"
        namespace="https://f88.com.vn/loan-onboarding/dmn/loan">
    <decision id="loanPurposeEligibility" name="Loan Purpose Eligibility">
        <decisionTable id="DecisionTable_LoanPurposeEligibility" hitPolicy="FIRST">
            <input id="Input_LoanPurpose" label="Loan purpose">
                <inputExpression id="InputExpression_LoanPurpose" typeRef="string">
                    <text>loanPurpose</text>
                </inputExpression>
            </input>
            <input id="Input_LoanPurposeAllowed" label="Loan purpose is allowed">
                <inputExpression id="InputExpression_LoanPurposeAllowed" typeRef="boolean">
                    <text>loanPurpose = "BUSINESS" or loanPurpose = "PERSONAL_CONSUMPTION" or loanPurpose = "VEHICLE_REPAIR" or loanPurpose = "MEDICAL" or loanPurpose = "EDUCATION" or loanPurpose = "HOME_REPAIR" or loanPurpose = "DEBT_REPAYMENT" or loanPurpose = "OTHER"</text>
                </inputExpression>
            </input>
            <output id="Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="Rule_LoanPurposeNull">
                <inputEntry id="InputEntry_LoanPurposeNull"><text>null</text></inputEntry>
                <inputEntry id="InputEntry_LoanPurposeNullAllowed"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_LoanPurposeNullPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_LoanPurposeNullReasonCode"><text>"LOAN_PURPOSE_ALLOWED"</text></outputEntry>
                <outputEntry id="OutputEntry_LoanPurposeNullReasonMessage"><text>"Loan purpose is required"</text></outputEntry>
            </rule>
            <rule id="Rule_LoanPurposeBlank">
                <inputEntry id="InputEntry_LoanPurposeBlank"><text>""</text></inputEntry>
                <inputEntry id="InputEntry_LoanPurposeBlankAllowed"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_LoanPurposeBlankPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_LoanPurposeBlankReasonCode"><text>"LOAN_PURPOSE_ALLOWED"</text></outputEntry>
                <outputEntry id="OutputEntry_LoanPurposeBlankReasonMessage"><text>"Loan purpose is required"</text></outputEntry>
            </rule>
            <rule id="Rule_LoanPurposeNotAllowed">
                <inputEntry id="InputEntry_LoanPurposeNotAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_LoanPurposeNotAllowed"><text>false</text></inputEntry>
                <outputEntry id="OutputEntry_LoanPurposeNotAllowedPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_LoanPurposeNotAllowedReasonCode"><text>"LOAN_PURPOSE_ALLOWED"</text></outputEntry>
                <outputEntry id="OutputEntry_LoanPurposeNotAllowedReasonMessage"><text>"Loan purpose is not allowed"</text></outputEntry>
            </rule>
            <rule id="Rule_LoanPurposeAllowed">
                <inputEntry id="InputEntry_LoanPurposeAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_LoanPurposeAllowed"><text>true</text></inputEntry>
                <outputEntry id="OutputEntry_LoanPurposeAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="OutputEntry_LoanPurposeAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="OutputEntry_LoanPurposeAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
