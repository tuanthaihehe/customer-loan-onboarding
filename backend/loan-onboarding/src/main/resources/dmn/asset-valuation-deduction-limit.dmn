<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_AssetValuationDeductionLimit"
        name="Asset Valuation Deduction Limit"
        namespace="https://f88.com.vn/loan-onboarding/dmn/valuation">
    <decision id="assetValuationDeductionLimit" name="Asset Valuation Deduction Limit">
        <decisionTable id="DecisionTable_AssetValuationDeductionLimit" hitPolicy="FIRST">
            <input id="Input_MarketValue" label="Market value">
                <inputExpression id="InputExpression_MarketValue" typeRef="number">
                    <text>marketValue</text>
                </inputExpression>
            </input>
            <input id="Input_TotalDeductionAmount" label="Total deduction amount">
                <inputExpression id="InputExpression_TotalDeductionAmount" typeRef="number">
                    <text>totalDeductionAmount</text>
                </inputExpression>
            </input>
            <output id="Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="Rule_MarketValueNull">
                <inputEntry id="InputEntry_MarketValueNull"><text>null</text></inputEntry>
                <inputEntry id="InputEntry_MarketValueNullDeduction"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_MarketValueNullPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_MarketValueNullReasonCode"><text>"ASSET_VALUATION_DEDUCTION_LIMIT"</text></outputEntry>
                <outputEntry id="OutputEntry_MarketValueNullReasonMessage"><text>"Market value and total deduction amount are required"</text></outputEntry>
            </rule>
            <rule id="Rule_TotalDeductionAmountNull">
                <inputEntry id="InputEntry_TotalDeductionAmountNullMarket"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_TotalDeductionAmountNull"><text>null</text></inputEntry>
                <outputEntry id="OutputEntry_TotalDeductionAmountNullPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_TotalDeductionAmountNullReasonCode"><text>"ASSET_VALUATION_DEDUCTION_LIMIT"</text></outputEntry>
                <outputEntry id="OutputEntry_TotalDeductionAmountNullReasonMessage"><text>"Market value and total deduction amount are required"</text></outputEntry>
            </rule>
            <rule id="Rule_TotalDeductionNegative">
                <inputEntry id="InputEntry_TotalDeductionNegativeMarket"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_TotalDeductionNegative"><text>&lt; 0</text></inputEntry>
                <outputEntry id="OutputEntry_TotalDeductionNegativePassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_TotalDeductionNegativeReasonCode"><text>"ASSET_VALUATION_DEDUCTION_LIMIT"</text></outputEntry>
                <outputEntry id="OutputEntry_TotalDeductionNegativeReasonMessage"><text>"Total deduction amount must not be negative"</text></outputEntry>
            </rule>
            <rule id="Rule_TotalDeductionGreaterThanMarket">
                <inputEntry id="InputEntry_TotalDeductionGreaterThanMarketMarket"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_TotalDeductionGreaterThanMarket"><text>&gt; marketValue</text></inputEntry>
                <outputEntry id="OutputEntry_TotalDeductionGreaterThanMarketPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_TotalDeductionGreaterThanMarketReasonCode"><text>"ASSET_VALUATION_DEDUCTION_LIMIT"</text></outputEntry>
                <outputEntry id="OutputEntry_TotalDeductionGreaterThanMarketReasonMessage"><text>"Tong giam tru khong duoc lon hon gia thi truong."</text></outputEntry>
            </rule>
            <rule id="Rule_AssetValuationDeductionPassed">
                <inputEntry id="InputEntry_AssetValuationDeductionPassedMarket"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_AssetValuationDeductionPassedDeduction"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_AssetValuationDeductionPassed"><text>true</text></outputEntry>
                <outputEntry id="OutputEntry_AssetValuationDeductionReasonCode"><text>null</text></outputEntry>
                <outputEntry id="OutputEntry_AssetValuationDeductionReasonMessage"><text>null</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
