<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_AssetRequiredCheck"
        name="Asset Required Check"
        namespace="https://f88.com.vn/loan-onboarding/dmn/asset">
    <decision id="assetRequiredCheck" name="Asset Required Check">
        <decisionTable id="DecisionTable_AssetRequiredCheck" hitPolicy="FIRST">
            <input id="Input_AssetType" label="Asset type">
                <inputExpression id="InputExpression_AssetType" typeRef="string">
                    <text>assetType</text>
                </inputExpression>
            </input>
            <input id="Input_LicensePlate" label="License plate">
                <inputExpression id="InputExpression_LicensePlate" typeRef="string">
                    <text>licensePlate</text>
                </inputExpression>
            </input>
            <output id="Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="Rule_MissingAssetType">
                <inputEntry id="InputEntry_MissingAssetType"><text>null</text></inputEntry>
                <inputEntry id="InputEntry_MissingAssetTypePlate"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_MissingAssetTypePassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_MissingAssetTypeReasonCode"><text>"ASSET_REQUIRED"</text></outputEntry>
                <outputEntry id="OutputEntry_MissingAssetTypeReasonMessage"><text>"Asset type and license plate are required before linking asset to loan application"</text></outputEntry>
            </rule>
            <rule id="Rule_MissingLicensePlateNull">
                <inputEntry id="InputEntry_MissingLicensePlateNullAssetType"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_MissingLicensePlateNull"><text>null</text></inputEntry>
                <outputEntry id="OutputEntry_MissingLicensePlateNullPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_MissingLicensePlateNullReasonCode"><text>"ASSET_REQUIRED"</text></outputEntry>
                <outputEntry id="OutputEntry_MissingLicensePlateNullReasonMessage"><text>"Asset type and license plate are required before linking asset to loan application"</text></outputEntry>
            </rule>
            <rule id="Rule_MissingLicensePlateBlank">
                <inputEntry id="InputEntry_MissingLicensePlateBlankAssetType"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_MissingLicensePlateBlank"><text>""</text></inputEntry>
                <outputEntry id="OutputEntry_MissingLicensePlateBlankPassed"><text>false</text></outputEntry>
                <outputEntry id="OutputEntry_MissingLicensePlateBlankReasonCode"><text>"ASSET_REQUIRED"</text></outputEntry>
                <outputEntry id="OutputEntry_MissingLicensePlateBlankReasonMessage"><text>"Asset type and license plate are required before linking asset to loan application"</text></outputEntry>
            </rule>
            <rule id="Rule_AssetRequiredPassed">
                <inputEntry id="InputEntry_AssetRequiredPassedAssetType"><text>-</text></inputEntry>
                <inputEntry id="InputEntry_AssetRequiredPassedLicensePlate"><text>-</text></inputEntry>
                <outputEntry id="OutputEntry_AssetRequiredPassed"><text>true</text></outputEntry>
                <outputEntry id="OutputEntry_AssetRequiredReasonCode"><text>null</text></outputEntry>
                <outputEntry id="OutputEntry_AssetRequiredReasonMessage"><text>null</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
