<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
        id="Definitions_LoanRequestRules"
        name="Loan Request Rules"
        namespace="https://f88.com.vn/loan-onboarding/dmn/loan-request-rules">
<decision id="loanPurposeEligibility" name="Loan Purpose Eligibility">
        <decisionTable id="LoanPurpose_DecisionTable_LoanPurposeEligibility" hitPolicy="FIRST">
            <input id="LoanPurpose_Input_LoanPurpose" label="Loan purpose">
                <inputExpression id="LoanPurpose_InputExpression_LoanPurpose" typeRef="string">
                    <text>loanPurpose</text>
                </inputExpression>
            </input>
            <input id="LoanPurpose_Input_LoanPurposeAllowed" label="Loan purpose is allowed">
                <inputExpression id="LoanPurpose_InputExpression_LoanPurposeAllowed" typeRef="boolean">
                    <text>loanPurpose = "BUSINESS" or loanPurpose = "PERSONAL_CONSUMPTION" or loanPurpose = "VEHICLE_REPAIR" or loanPurpose = "MEDICAL" or loanPurpose = "EDUCATION" or loanPurpose = "HOME_REPAIR" or loanPurpose = "DEBT_REPAYMENT" or loanPurpose = "OTHER"</text>
                </inputExpression>
            </input>
            <output id="LoanPurpose_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="LoanPurpose_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="LoanPurpose_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="LoanPurpose_Rule_LoanPurposeNull">
                <inputEntry id="LoanPurpose_InputEntry_LoanPurposeNull"><text>null</text></inputEntry>
                <inputEntry id="LoanPurpose_InputEntry_LoanPurposeNullAllowed"><text>-</text></inputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeNullPassed"><text>false</text></outputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeNullReasonCode"><text>"LOAN_PURPOSE_ALLOWED"</text></outputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeNullReasonMessage"><text>"Loan purpose is required"</text></outputEntry>
            </rule>
            <rule id="LoanPurpose_Rule_LoanPurposeBlank">
                <inputEntry id="LoanPurpose_InputEntry_LoanPurposeBlank"><text>""</text></inputEntry>
                <inputEntry id="LoanPurpose_InputEntry_LoanPurposeBlankAllowed"><text>-</text></inputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeBlankPassed"><text>false</text></outputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeBlankReasonCode"><text>"LOAN_PURPOSE_ALLOWED"</text></outputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeBlankReasonMessage"><text>"Loan purpose is required"</text></outputEntry>
            </rule>
            <rule id="LoanPurpose_Rule_LoanPurposeNotAllowed">
                <inputEntry id="LoanPurpose_InputEntry_LoanPurposeNotAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="LoanPurpose_InputEntry_LoanPurposeNotAllowed"><text>false</text></inputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeNotAllowedPassed"><text>false</text></outputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeNotAllowedReasonCode"><text>"LOAN_PURPOSE_ALLOWED"</text></outputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeNotAllowedReasonMessage"><text>"Loan purpose is not allowed"</text></outputEntry>
            </rule>
            <rule id="LoanPurpose_Rule_LoanPurposeAllowed">
                <inputEntry id="LoanPurpose_InputEntry_LoanPurposeAllowedValue"><text>-</text></inputEntry>
                <inputEntry id="LoanPurpose_InputEntry_LoanPurposeAllowed"><text>true</text></inputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="LoanPurpose_OutputEntry_LoanPurposeAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
<decision id="loanTenureEligibility" name="Loan Tenure Eligibility">
        <decisionTable id="LoanTenure_DecisionTable_LoanTenureEligibility" hitPolicy="FIRST">
            <input id="LoanTenure_Input_RequestedTenure" label="Requested tenure">
                <inputExpression id="LoanTenure_InputExpression_RequestedTenure" typeRef="integer">
                    <text>requestedTenure</text>
                </inputExpression>
            </input>
            <output id="LoanTenure_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="LoanTenure_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="LoanTenure_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="LoanTenure_Rule_RequestedTenureNull">
                <inputEntry id="LoanTenure_InputEntry_RequestedTenureNull"><text>null</text></inputEntry>
                <outputEntry id="LoanTenure_OutputEntry_RequestedTenureNullPassed"><text>false</text></outputEntry>
                <outputEntry id="LoanTenure_OutputEntry_RequestedTenureNullReasonCode"><text>"LOAN_TENURE_ALLOWED"</text></outputEntry>
                <outputEntry id="LoanTenure_OutputEntry_RequestedTenureNullReasonMessage"><text>"Requested tenure is required"</text></outputEntry>
            </rule>
            <rule id="LoanTenure_Rule_RequestedTenureAllowed">
                <inputEntry id="LoanTenure_InputEntry_RequestedTenureAllowed"><text>3, 6, 9, 12, 18, 24</text></inputEntry>
                <outputEntry id="LoanTenure_OutputEntry_RequestedTenureAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="LoanTenure_OutputEntry_RequestedTenureAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="LoanTenure_OutputEntry_RequestedTenureAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
            <rule id="LoanTenure_Rule_RequestedTenureNotAllowed">
                <inputEntry id="LoanTenure_InputEntry_RequestedTenureNotAllowed"><text>-</text></inputEntry>
                <outputEntry id="LoanTenure_OutputEntry_RequestedTenureNotAllowedPassed"><text>false</text></outputEntry>
                <outputEntry id="LoanTenure_OutputEntry_RequestedTenureNotAllowedReasonCode"><text>"LOAN_TENURE_ALLOWED"</text></outputEntry>
                <outputEntry id="LoanTenure_OutputEntry_RequestedTenureNotAllowedReasonMessage"><text>"Requested tenure must be one of 3, 6, 9, 12, 18, 24 months"</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
<decision id="requestedAmountLimit" name="Requested Amount Limit">
        <decisionTable id="RequestedAmount_DecisionTable_RequestedAmountLimit" hitPolicy="FIRST">
            <input id="RequestedAmount_Input_RequestedAmount" label="Requested amount">
                <inputExpression id="RequestedAmount_InputExpression_RequestedAmount" typeRef="number">
                    <text>requestedAmount</text>
                </inputExpression>
            </input>
            <output id="RequestedAmount_Output_Passed" label="Passed" name="passed" typeRef="boolean"/>
            <output id="RequestedAmount_Output_ReasonCode" label="Reason Code" name="reasonCode" typeRef="string"/>
            <output id="RequestedAmount_Output_ReasonMessage" label="Reason Message" name="reasonMessage" typeRef="string"/>
            <rule id="RequestedAmount_Rule_RequestedAmountNull">
                <inputEntry id="RequestedAmount_InputEntry_RequestedAmountNull"><text>null</text></inputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountNullPassed"><text>false</text></outputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountNullReasonCode"><text>"REQUESTED_AMOUNT_LIMIT"</text></outputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountNullReasonMessage"><text>"Requested amount is required"</text></outputEntry>
            </rule>
            <rule id="RequestedAmount_Rule_RequestedAmountTooLow">
                <inputEntry id="RequestedAmount_InputEntry_RequestedAmountTooLow"><text>&lt; 1000000</text></inputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountTooLowPassed"><text>false</text></outputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountTooLowReasonCode"><text>"REQUESTED_AMOUNT_LIMIT"</text></outputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountTooLowReasonMessage"><text>"Requested amount must be at least 1000000"</text></outputEntry>
            </rule>
            <rule id="RequestedAmount_Rule_RequestedAmountTooHigh">
                <inputEntry id="RequestedAmount_InputEntry_RequestedAmountTooHigh"><text>&gt; 100000000</text></inputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountTooHighPassed"><text>false</text></outputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountTooHighReasonCode"><text>"REQUESTED_AMOUNT_LIMIT"</text></outputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountTooHighReasonMessage"><text>"Requested amount must not exceed 100000000"</text></outputEntry>
            </rule>
            <rule id="RequestedAmount_Rule_RequestedAmountAllowed">
                <inputEntry id="RequestedAmount_InputEntry_RequestedAmountAllowed"><text>-</text></inputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountAllowedPassed"><text>true</text></outputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountAllowedReasonCode"><text>null</text></outputEntry>
                <outputEntry id="RequestedAmount_OutputEntry_RequestedAmountAllowedReasonMessage"><text>null</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
