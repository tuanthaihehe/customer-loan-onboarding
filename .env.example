# ─────────────────────────────────────────────────────────
# Copy file này thành .env và điền giá trị thực tế.
# .env KHÔNG được commit lên git.
# ─────────────────────────────────────────────────────────

# ── Spring Boot ──────────────────────────────────────────
SERVER_PORT=8080

# ── Frontend Docker/Nginx ────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=/api/v1

# ── Database (dùng khi chạy profile db) ─────────────────
# Khi chạy với Docker: DB_URL dùng localhost, port theo POSTGRES_PORT
DB_URL=jdbc:postgresql://localhost:5432/loan_onboarding
DB_USERNAME=postgres
DB_PASSWORD=123456

# ── PostgreSQL Docker service ────────────────────────────
# Port PostgreSQL expose ra máy host (đổi nếu bị xung đột với local PG)
POSTGRES_PORT=5432

# ── FPT AI OCR ───────────────────────────────────────────
# PRODUCTION: thay bằng API key thật, không commit key lên git
FPTAI_API_KEY=4bJQ260mMGnatYeR3uk07xS7V3QkL1I1

# ── AWS S3 document storage ──────────────────────────────
# PRODUCTION: ưu tiên IAM role; chỉ dùng access key cho local/dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
# Dùng khi test với LocalStack/MinIO, bỏ trống khi dùng AWS S3 thật.
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_URL_BASE=
AWS_S3_PATH_STYLE_ACCESS_ENABLED=false
